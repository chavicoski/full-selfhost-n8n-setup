# ==================================
# N8N AI WORKFLOW DOCKER COMPOSE ENV
# ==================================
# Copy this file to .env and customize the values below
#
# QUICK START:
# 1. Run: ./scripts/generate-env.sh (auto-generates secure passwords)
# 2. Or manually edit the values marked with 'your_*_here'
# 3. Validate: ./scripts/validate.sh
# 4. Start: ./scripts/start.sh
#
# DEPLOYMENT MODES:
# - Development: ./scripts/start.sh (includes PgAdmin, debug logging)
# - Production:  ./scripts/start.sh -e production (SSL, security hardening)
# - With GPU:    ./scripts/start.sh -g (enables GPU acceleration)
# - With Models: ./scripts/start.sh -m (auto-installs AI models)
#
# ACCESS URLS:
# - n8n Interface: http://localhost:5678
# - PgAdmin (dev): http://localhost:5050
# - Ollama API:    http://localhost:11434
#
# AI MODEL MANAGEMENT:
# - Install models: ./scripts/manage-models.sh recommended
# - List models:    ./scripts/manage-models.sh list
# - Test models:    ./scripts/manage-models.sh test llama2

# ==================================
# PROJECT CONFIGURATION
# ==================================
# Container name prefix (affects all container names)
COMPOSE_PROJECT_NAME=n8n-ai-stack

# System timezone (affects logs and n8n workflows)
TIMEZONE=UTC

# Docker network configuration
NETWORK_SUBNET=172.20.0.0/16
NETWORK_NAME=n8n-network

# ==================================
# POSTGRESQL DATABASE CONFIGURATION
# ==================================
# PostgreSQL version (recommend: 15-alpine for production, latest for dev)
POSTGRES_VERSION=15-alpine

# Database configuration
POSTGRES_DB=n8n
POSTGRES_USER=postgres                                    # Admin user
POSTGRES_PASSWORD=your_secure_postgres_password_here      # REQUIRED: Admin password
# Note: n8n connects directly using the postgres admin user (no separate user needed)

# Port configuration
POSTGRES_EXTERNAL_PORT=5432   # Host port (set to different value if 5432 is busy)
POSTGRES_INTERNAL_PORT=5432   # Container port (usually keep as 5432)

# Resource Limits: None configured - services run with unlimited resources
# Health checks are configured directly in docker-compose files

# ==================================
# N8N CONFIGURATION
# ==================================
N8N_VERSION=latest
N8N_HOST=localhost
N8N_INTERNAL_PORT=5678
N8N_EXTERNAL_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678

# User Configuration
N8N_USER_ID=1000
N8N_GROUP_ID=1000

# Resource Limits: None configured - services run with unlimited resources
# Health checks are configured directly in docker-compose files

# Security (REQUIRED - Generate secure random strings)
# Generate with: openssl rand -base64 32
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here
# Generate with: openssl rand -base64 64
N8N_JWT_SECRET=your_jwt_secret_here

# Database Schema
N8N_DB_SCHEMA=public

# Features & Logging
N8N_METRICS=false
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_AI_ENABLED=true
N8N_HIDE_USAGE_PAGE=true

# Execution Configuration
N8N_EXECUTIONS_PROCESS=main
N8N_EXECUTIONS_MODE=regular
N8N_EXECUTIONS_TIMEOUT=3600
N8N_EXECUTIONS_TIMEOUT_MAX=3600
N8N_EXECUTIONS_DATA_SAVE_ON_ERROR=all
N8N_EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
N8N_EXECUTIONS_DATA_SAVE_ON_MANUAL_EXECUTION=all

# Additional n8n Configuration
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
N8N_PERSISTED_BINARY_DATA_TTL=1440
N8N_BINARY_DATA_MANAGER_MODE=filesystem
N8N_DISABLE_UI=false
N8N_BASIC_AUTH_ACTIVE=false
N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=false

# ==================================
# OLLAMA CONFIGURATION
# ==================================
OLLAMA_VERSION=latest
OLLAMA_EXTERNAL_PORT=11434
OLLAMA_INTERNAL_PORT=11434
OLLAMA_HOST=0.0.0.0
OLLAMA_ORIGINS=*

# No resource limits configured - services run with unlimited resources
# Health checks are configured directly in docker-compose files

# ==================================
# TRAEFIK CONFIGURATION (OPTIONAL - For Production)
# ==================================
# These are used when running with --profile production
# Leave commented for development, uncomment for production

# Traefik version and basic configuration
TRAEFIK_VERSION=v2.10
TRAEFIK_API_INSECURE=false                      # Set to true only for development

# Port configuration
TRAEFIK_HTTP_PORT=80                            # HTTP port (redirects to HTTPS)
TRAEFIK_HTTPS_PORT=443                          # HTTPS port
TRAEFIK_DASHBOARD_PORT=8080                     # Traefik dashboard port

# Domain configuration (REQUIRED for production)
DOMAIN=localhost                                # Your base domain
TRAEFIK_DOMAIN=traefik.localhost               # Traefik dashboard subdomain
ACME_EMAIL=admin@localhost                      # Email for Let's Encrypt certificates (dev default)

# Advanced configuration
DOCKER_SOCKET_PATH=/var/run/docker.sock          # Docker socket path
TRAEFIK_CERTS_PATH=/letsencrypt                  # Certificate storage path

# ==================================
# DEVELOPMENT CONFIGURATION
# ==================================
# PgAdmin database management tool (only used in development mode)
# Access at: http://localhost:5050
PGADMIN_VERSION=latest
PGADMIN_EMAIL=admin@example.com                     # Login email for PgAdmin
PGADMIN_PASSWORD=admin123                          # Login password for PgAdmin
PGADMIN_PORT=5050                                  # External port for PgAdmin

# PgAdmin configuration
PGADMIN_SERVER_MODE=False                          # Single-user mode
PGADMIN_COOKIE_PROTECTION=False                    # Disable for development
PGADMIN_LOGIN_BANNER="N8N Development Environment"   # Custom login banner

# Development mode settings (automatically configured by docker-compose.dev.yml):
# - N8N_LOG_LEVEL=debug
# - N8N_METRICS=true
# - NODE_ENV=development
# - PgAdmin enabled for database management

# ==================================
# PRODUCTION CONFIGURATION
# ==================================
# Production data paths (for docker-compose.prod.yml)
POSTGRES_DATA_PATH=./data/postgres
OLLAMA_DATA_PATH=./data/ollama
N8N_DATA_PATH=./data/n8n

# Production domain configuration (REQUIRED for production)
N8N_DOMAIN=n8n.localhost                           # Domain for n8n in production
N8N_DISABLE_PRODUCTION_UI=false

# Traefik basic auth (generate with: htpasswd -nb admin password)
TRAEFIK_BASIC_AUTH=admin:$$2y$$10$$example

# Production mode settings (automatically configured by docker-compose.prod.yml):
# - NODE_ENV=production
# - N8N_LOG_LEVEL=warn
# - N8N_METRICS=true
# - Host-bound volumes for data persistence
# - Traefik SSL termination and reverse proxy
# - PostgreSQL port not exposed externally

# ==================================
# VOLUME PATHS (ADVANCED)
# ==================================
# Customize these paths if needed
N8N_CUSTOM_NODES_PATH=./custom-nodes
N8N_BACKUPS_PATH=./backups
N8N_LOGS_PATH=./logs
# Note: PostgreSQL automatically initializes with n8n connecting as admin user

# ==================================
# SECURITY NOTES
# ==================================
# 1. Generate a secure N8N_ENCRYPTION_KEY:
#    openssl rand -base64 32
#
# 2. Generate a secure N8N_JWT_SECRET:
#    openssl rand -base64 64
#
# 3. Use strong passwords for POSTGRES_PASSWORD and POSTGRES_NON_ROOT_PASSWORD
#
# 4. For production, consider:
#    - Using Docker secrets instead of environment variables
#    - Setting up SSL/TLS certificates
#    - Configuring firewall rules
#    - Regular backups
#
# ==================================
# OLLAMA MODEL MANAGEMENT
# ==================================
# After starting the stack, you can manage Ollama models:
#
# List available models:
# docker exec ${COMPOSE_PROJECT_NAME}_ollama ollama list
#
# Pull a model (e.g., llama2):
# docker exec ${COMPOSE_PROJECT_NAME}_ollama ollama pull llama2
#
# Pull other useful models for n8n workflows:
# docker exec ${COMPOSE_PROJECT_NAME}_ollama ollama pull codellama
# docker exec ${COMPOSE_PROJECT_NAME}_ollama ollama pull mistral
# docker exec ${COMPOSE_PROJECT_NAME}_ollama ollama pull phi
#
# Check Ollama API:
# curl http://localhost:${OLLAMA_EXTERNAL_PORT}/api/version